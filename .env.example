# Lingkungan Aplikasi (development / production / test)
NODE_ENV=development

# Konfigurasi Server Express
PORT=3000

# Konfigurasi Koneksi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sipangan_db

# Kredensial Keamanan & Token
API_KEY=api_key_rahasia_operator_anda
JWT_SECRET=rahasia_jwt_token_akses_anda
REFRESH_TOKEN_SECRET=rahasia_jwt_token_refresh_anda

# Konfigurasi Layanan Machine Learning / AI (FastAPI)
FASTAPI_URL=http://localhost:8000

# Pengaturan CORS (Daftar asal/origin yang diizinkan, dipisahkan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Konfigurasi Redis Cache (Opsional untuk performa cepat caching cuaca/data)
# REDIS_SOCKET_PATH=/home/username/.redis/redis.sock
REDIS_URL=redis://localhost:6379

# Kredensial Pengaman Dokumentasi API Swagger (Basic Authentication)
SWAGGER_USER=admin_swagger
SWAGGER_PASSWORD=password_swagger
